                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "format": "int64"
                    },
                    "title": {
                        "type": "string"
                    },
                    "coverImage": {
                        "type": "string"
                    },
                    "fileKey": {
                        "type": "string",
                        "readOnly": true
                    },
                    "content": {
                        "type": "string"
                    },
                    "statusId": {
                        "type": "integer",
                        "format": "int32",
                        "readOnly": true
                    },
                    "userId": {
                        "type": "integer",
                        "format": "int64",
                        "readOnly": true
                    },
                    "categoryId": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "scopeId": {
                        "type": "integer",
                        "format": "int32",
                        "readOnly": true
                    },
                    "isPublic": {
                        "type": "boolean"
                    },
                    "publishAt": {
                        "type": "string",
                        "format": "date-time",
                        "readOnly": true
                    },
                    "viewCount": {
                        "type": "integer",
                        "format": "int64",
                        "readOnly": true
                    },
                    "commentCount": {
                        "type": "integer",
                        "format": "int64",
                        "readOnly": true
                    },
                    "feedbackStats": {
                        "$ref": "#/components/schemas/FeedbackStatsDTO"
                    },
                    "createdAt": {
                        "type": "string",
                        "format": "date-time",
                        "readOnly": true
                    },
                    "updatedAt": {
                        "type": "string",
                        "format": "date-time",
                        "readOnly": true
                    },
                    "feedbackConfig": {
                        "$ref": "#/components/schemas/FeedbackConfigDTO"
                    }
                }
            },
            "ReactionResponseDTO": {
                "type": "object",
                "properties": {
                    "count": {
                        "type": "integer",
                        "format": "int64"
                    },
                    "userReacted": {
                        "type": "boolean"
                    }
                }
            },
            "CategoryDTO": {
                "required": [
                    "scopeId",
                    "title"
                ],
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "title": {
                        "type": "string"
                    },
                    "coverImage": {
                        "type": "string"
                    },
                    "fileKey": {
                        "type": "string",
                        "readOnly": true
                    },
                    "scopeId": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "enable": {
                        "type": "boolean"
                    },
                    "createdAt": {
                        "type": "string",
                        "format": "date-time",
                        "readOnly": true
                    },
                    "updatedAt": {
                        "type": "string",
                        "format": "date-time",
                        "readOnly": true
                    }
                }
            },
            "ResponseDTO": {
                "type": "object",
                "properties": {
                    "code": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "message": {
                        "type": "string"
                    }
                }
            },
            "ReactionDTO": {
                "required": [
                    "modelId",
                    "modelTypeId",
                    "type"
                ],
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "format": "int32",
                        "readOnly": true
                    },
                    "userId": {
                        "type": "integer",
                        "format": "int64",
                        "readOnly": true
                    },
                    "ipAddress": {
                        "type": "string",
                        "readOnly": true
                    },
                    "modelTypeId": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "modelId": {
                        "type": "integer",
                        "format": "int64"
                    },
                    "type": {
                        "type": "string",
                        "enum": [
                            "LIKE",
                            "DISLIKE"
                        ]
                    },
                    "delete": {
                        "type": "boolean"
                    }
                }
            },
            "CommentRequestDTO": {
                "required": [
                    "modelId",
                    "text"
                ],
                "type": "object",
                "properties": {
                    "modelTypeId": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "modelId": {
                        "type": "integer",
                        "format": "int64"
                    },
                    "text": {
                        "type": "string"
                    },
                    "scopeId": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "userId": {
                        "type": "integer",
                        "format": "int64",
                        "readOnly": true
                    },
                    "publish": {
                        "type": "boolean",
                        "readOnly": true
                    },
                    "parentId": {
                        "type": "integer",
                        "format": "int64"
                    }
                }
            },
            "PublishPostDTO": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "format": "int64"
                    },
                    "scopeId": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "publish": {
                        "type": "boolean"
                    },
                    "unpublishReason": {
                        "type": "string"
                    }
                }
            },
            "PublishRequestDTO": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "format": "int64"
                    },
                    "scopeId": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "publish": {
                        "type": "boolean"
                    },
                    "reason": {
                        "type": "string"
                    }
                }
            },
            "PostSearchDTO": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "format": "int64"
                    },
                    "categoryIds": {
                        "type": "array",
                        "items": {
                            "type": "integer",
                            "format": "int32"
                        }
                    },
                    "statusId": {
                        "type": "integer",
                        "format": "int32"
